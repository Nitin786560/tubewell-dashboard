import React, { useState, useEffect } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { useQuery, useMutation } from "@tanstack/react-query";
import { apiRequest, queryClient } from "@/lib/queryClient";
import { User, Session } from "@shared/schema";

interface SessionLog {
  id: string;
  user: string;
  start: string;
  end: string;
  duration: string;
  fee: number;
  voltage: number;
  starterStatus: boolean;
}

interface DeviceStatus {
  voltage: number;
  motorRunning: boolean;
  timestamp: string;
}

export default function TubewellDashboard() {
  const [logs, setLogs] = useState<SessionLog[]>([]);
  const [activeUser, setActiveUser] = useState("");
  const [sessionStart, setSessionStart] = useState<Date | null>(null);
  const [realTimeVoltage, setRealTimeVoltage] = useState(0);
  const [motorStatus, setMotorStatus] = useState(false);
  const [showAddUser, setShowAddUser] = useState(false);
  const [newUser, setNewUser] = useState({ name: "", phone: "", whatsapp: "", password: "" });

  // Fetch all users from database
  const { data: users = [] } = useQuery<User[]>({
    queryKey: ["/api/users"],
  });

  // Fetch all sessions
  const { data: sessions = [] } = useQuery<Session[]>({
    queryKey: ["/api/sessions"],
  });

  // Real-time voltage monitoring
  const { data: deviceVoltage } = useQuery({
    queryKey: ["/api/device/voltage"],
    refetchInterval: 5000, // Update every 5 seconds
    retry: false,
  });

  // Update real-time voltage when device data changes
  useEffect(() => {
    if (deviceVoltage?.voltage) {
      setRealTimeVoltage(deviceVoltage.voltage);
    }
  }, [deviceVoltage]);

  // Start session mutation
  const startSessionMutation = useMutation({
    mutationFn: async () => {
      const res = await apiRequest("POST", "/api/sessions/start", {
        userId: parseInt(activeUser),
        voltage: realTimeVoltage,
        starterStatus: true,
      });
      return await res.json();
    },
    onSuccess: () => {
      setSessionStart(new Date());
      setMotorStatus(true);
      queryClient.invalidateQueries({ queryKey: ["/api/sessions"] });
      alert(`Pump started successfully!\nVoltage: ${realTimeVoltage}V\nMotor: ON`);
    },
    onError: () => {
      alert("Failed to start pump. Please check device connection.");
    },
  });

  // Stop session mutation
  const stopSessionMutation = useMutation({
    mutationFn: async () => {
      const res = await apiRequest("POST", "/api/sessions/stop", {
        userId: parseInt(activeUser),
      });
      return await res.json();
    },
    onSuccess: (data) => {
      setSessionStart(null);
      setMotorStatus(false);
      queryClient.invalidateQueries({ queryKey: ["/api/sessions"] });
      alert(`Pump stopped successfully!\nFee: ₹${data.fee}`);
    },
    onError: () => {
      alert("Failed to stop pump. Please check device connection.");
    },
  });

  // Add new user mutation
  const addUserMutation = useMutation({
    mutationFn: async () => {
      const res = await apiRequest("POST", "/api/users", newUser);
      return await res.json();
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["/api/users"] });
      setNewUser({ name: "", phone: "", whatsapp: "", password: "" });
      setShowAddUser(false);
      alert("User added successfully!");
    },
    onError: () => {
      alert("Failed to add user. Please check the details.");
    },
  });

  // Send monthly report via WhatsApp
  const sendMonthlyReportMutation = useMutation({
    mutationFn: async (userId: number) => {
      const res = await apiRequest("POST", "/api/reports/monthly", { userId });
      return await res.json();
    },
    onSuccess: () => {
      alert("Monthly report sent via WhatsApp successfully!");
    },
    onError: () => {
      alert("Failed to send WhatsApp report. Please check your WhatsApp API configuration.");
    },
  });

  const handleStart = () => {
    if (!activeUser) {
      alert("Please select a user");
      return;
    }
    if (realTimeVoltage < 200) {
      alert("Voltage too low. Please check electrical connection.");
      return;
    }
    startSessionMutation.mutate();
  };

  const handleStop = () => {
    if (!activeUser || !sessionStart) return;
    stopSessionMutation.mutate();
  };

  const handleAddUser = () => {
    if (!newUser.name || !newUser.phone || !newUser.whatsapp || !newUser.password) {
      alert("Please fill all fields");
      return;
    }
    addUserMutation.mutate();
  };

  const sendWhatsAppReport = (userId: number) => {
    sendMonthlyReportMutation.mutate(userId);
  };

  const downloadUserReport = async (userId: number) => {
    try {
      const res = await apiRequest("GET", `/api/reports/download/${userId}`);
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `user_${userId}_report.pdf`;
      a.click();
      window.URL.revokeObjectURL(url);
    } catch (error) {
      alert("Failed to download report");
    }
  };

  const sendAllMonthlyReports = () => {
    users.forEach(user => {
      sendWhatsAppReport(user.id);
    });
  };

  return (
    <div className="p-6 max-w-6xl mx-auto">
      <h1 className="text-3xl font-bold mb-6">Master Tubewell Dashboard</h1>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        {/* User Selection & Controls */}
        <Card>
          <CardContent className="p-4">
            <h2 className="text-xl font-semibold mb-2">User Selection & Controls</h2>
            <select
              className="w-full border rounded p-2 mb-3"
              value={activeUser}
              onChange={(e) => setActiveUser(e.target.value)}
            >
              <option value="">-- Select User --</option>
              {Object.entries(users).map(([id, user]) => (
                <option key={id} value={id}>
                  {user.name} ({user.phone})
                </option>
              ))}
            </select>

            <div className="grid grid-cols-2 gap-2 mb-3">
              <div>
                <label className="block text-sm font-medium mb-1">Voltage</label>
                <Input
                  type="number"
                  placeholder="Enter voltage"
                  value={voltage}
                  onChange={(e) => setVoltage(e.target.value)}
                />
              </div>
              <div>
                <label className="block text-sm font-medium mb-1">Starter</label>
                <Button
                  variant={starterStatus ? "default" : "outline"}
                  size="sm"
                  onClick={() => setStarterStatus(!starterStatus)}
                  className="w-full"
                >
                  {starterStatus ? "ON" : "OFF"}
                </Button>
              </div>
            </div>

            <div className="flex gap-2">
              <Button 
                onClick={handleStart} 
                disabled={!activeUser || !voltage || sessionStart}
                className="flex-1 bg-green-600 hover:bg-green-700"
              >
                Start Pump
              </Button>
              <Button
                onClick={handleStop}
                variant="destructive"
                disabled={!sessionStart}
                className="flex-1"
              >
                Stop Pump
              </Button>
            </div>
          </CardContent>
        </Card>

        {/* Current Status */}
        <Card>
          <CardContent className="p-4">
            <h2 className="text-xl font-semibold mb-2">Current Status</h2>
            <div className="space-y-2">
              <div className="flex items-center gap-2">
                <div className={`w-3 h-3 rounded-full ${sessionStart ? 'bg-green-500 animate-pulse' : 'bg-gray-400'}`}></div>
                <span className="text-sm">
                  {sessionStart 
                    ? `Running since ${sessionStart.toLocaleTimeString()}` 
                    : 'No active session'
                  }
                </span>
              </div>
              {sessionStart && (
                <>
                  <p className="text-sm">User: {users[activeUser]?.name}</p>
                  <p className="text-sm">Voltage: {voltage}V</p>
                  <p className="text-sm">Starter: {starterStatus ? 'ON' : 'OFF'}</p>
                </>
              )}
            </div>
          </CardContent>
        </Card>

        {/* Monthly Reports */}
        <Card>
          <CardContent className="p-4">
            <h2 className="text-xl font-semibold mb-2">Monthly Reports</h2>
            <div className="space-y-2">
              <Button 
                variant="outline" 
                className="w-full"
                onClick={sendAllMonthlyReports}
              >
                📱 Send All Monthly Reports
              </Button>
              <Button 
                variant="outline" 
                className="w-full"
                onClick={() => activeUser && downloadUserReport(users[activeUser]?.name)}
                disabled={!activeUser}
              >
                📄 Download User PDF
              </Button>
              <div className="text-xs text-gray-500 p-2 bg-yellow-50 rounded border">
                ⚠️ Reports sent via WhatsApp automatically at month end
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      {/* Statistics */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <Card className="p-4">
          <div className="text-center">
            <p className="text-2xl font-bold">{logs.length}</p>
            <p className="text-sm text-gray-600">Total Sessions</p>
          </div>
        </Card>
        <Card className="p-4">
          <div className="text-center">
            <p className="text-2xl font-bold">
              {logs.reduce((sum, log) => sum + parseFloat(log.duration), 0).toFixed(1)}
            </p>
            <p className="text-sm text-gray-600">Total Hours</p>
          </div>
        </Card>
        <Card className="p-4">
          <div className="text-center">
            <p className="text-2xl font-bold">
              ₹{logs.reduce((sum, log) => sum + log.fee, 0).toFixed(2)}
            </p>
            <p className="text-sm text-gray-600">Total Revenue</p>
          </div>
        </Card>
        <Card className="p-4">
          <div className="text-center">
            <p className="text-2xl font-bold">{Object.keys(users).length}</p>
            <p className="text-sm text-gray-600">Active Users</p>
          </div>
        </Card>
      </div>

      {/* User Management & Session Logs */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {/* Users List */}
        <Card>
          <CardContent className="p-4">
            <div className="flex justify-between items-center mb-4">
              <h2 className="text-xl font-semibold">All Users</h2>
              <Button size="sm">+ Add User</Button>
            </div>
            <div className="space-y-2">
              {Object.entries(users).map(([id, user]) => (
                <div key={id} className="flex justify-between items-center p-2 border rounded">
                  <div>
                    <p className="font-medium">{user.name}</p>
                    <p className="text-sm text-gray-600">{user.phone}</p>
                  </div>
                  <div className="flex gap-1">
                    <Button
                      size="sm"
                      variant="outline"
                      onClick={() => downloadUserReport(user.name)}
                    >
                      📄
                    </Button>
                    <Button
                      size="sm"
                      variant="outline"
                      onClick={() => sendMonthlyReport(user.name)}
                    >
                      📱
                    </Button>
                  </div>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>

        {/* Session Logs */}
        <Card>
          <CardContent className="p-4">
            <h2 className="text-xl font-semibold mb-4">Session Logs</h2>
            <div className="overflow-auto max-h-96">
              <table className="w-full text-sm">
                <thead>
                  <tr className="text-left border-b">
                    <th className="p-2">User</th>
                    <th className="p-2">Duration</th>
                    <th className="p-2">Fee</th>
                    <th className="p-2">Voltage</th>
                    <th className="p-2">Starter</th>
                  </tr>
                </thead>
                <tbody>
                  {logs.length === 0 ? (
                    <tr>
                      <td colSpan={5} className="p-4 text-center text-gray-500">
                        No sessions recorded yet
                      </td>
                    </tr>
                  ) : (
                    logs.map((log) => (
                      <tr key={log.id} className="border-b">
                        <td className="p-2">{log.user}</td>
                        <td className="p-2">{log.duration}h</td>
                        <td className="p-2">₹{log.fee}</td>
                        <td className="p-2">{log.voltage}V</td>
                        <td className="p-2">
                          <span className={`px-2 py-1 rounded text-xs ${
                            log.starterStatus ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                          }`}>
                            {log.starterStatus ? 'ON' : 'OFF'}
                          </span>
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}
